# Public build-time settings only. Everything prefixed VITE_ ships in the browser bundle.

# API origin, e.g. https://api.example.com (no trailing slash).
# Leave empty to call the same origin: the Vite dev proxy locally, or a reverse proxy
# that serves /api in production. When set, add this app's origin to the API's
# Cors:AllowedOrigins (Cors__AllowedOrigins__0=https://app.example.com).
VITE_API_BASE_URL=
