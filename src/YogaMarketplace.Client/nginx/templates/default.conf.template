# Rendered by the nginx image at start-up: ${API_UPSTREAM} and ${API_ORIGIN} come from the container environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Certificate and photo uploads pass through to the API.
    client_max_body_size 15m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The API sets its own security headers.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    # Vite fingerprints everything under /assets, so it can be cached for a year.
    location /assets/ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA routing: any unknown path (for example /admin/bookings/123 on refresh) serves the app shell.
    location / {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
