<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>yoga-marketplace-api</UserSecretsId>
    <SpaRoot>..\YogaMarketplace.Client\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YogaMarketplace.Infrastructure\YogaMarketplace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YogaMarketplace.Api.Tests" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="DemoData\demo-data.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    dotnet publish builds the SPA and ships it in wwwroot, so one IIS site serves both.
    VITE_API_BASE_URL is forced empty: the app calls /api on its own origin.
    Packages install only when node_modules is missing (a fresh clone or CI), so a running dev server's locks don't break it.
    Pass -p:SkipSpaBuild=true to publish the API alone.
  -->
  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" EnvironmentVariables="VITE_API_BASE_URL=" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
