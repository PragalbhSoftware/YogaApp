@host = http://localhost:5080

GET {{host}}/health

###
GET {{host}}/api/areas

###
GET {{host}}/api/categories

###
GET {{host}}/api/policy

###
POST {{host}}/api/auth/otp/request
Content-Type: application/json

{
  "phone": "9876543210",
  "name": "Rahul Sharma",
  "gender": "Male",
  "isNewUser": true
}

###
POST {{host}}/api/auth/otp/verify
Content-Type: application/json

{
  "phone": "9876543210",
  "code": "123456"
}

###
GET {{host}}/api/providers?area=Bandra&mode=Home&category=yoga

###
GET {{host}}/api/providers/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa4/slots?mode=Home

###
# Customer JWT from POST /api/auth/otp/verify. slotId comes from the slots call above.
POST {{host}}/api/bookings/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "slotId": "00000000-0000-0000-0000-000000000000",
  "homeAddress": "14th Road, Bandra West",
  "landmark": "Near the station"
}

###
POST {{host}}/api/bookings/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": "order_fake_example",
  "paymentId": "pay_example",
  "signature": "hex hmac sha256 of orderId|paymentId using Razorpay:KeySecret"
}

###
GET {{host}}/api/bookings/me
Authorization: Bearer {{token}}

###
# Instructor JWT (seeded Ananya: phone 9876543210, existing user).
GET {{host}}/api/bookings/instructor?status=PendingAccept
Authorization: Bearer {{instructorToken}}

###
POST {{host}}/api/bookings/00000000-0000-0000-0000-000000000000/accept
Authorization: Bearer {{instructorToken}}

###
POST {{host}}/api/bookings/00000000-0000-0000-0000-000000000000/decline
Authorization: Bearer {{instructorToken}}

###
POST {{host}}/api/bookings/00000000-0000-0000-0000-000000000000/complete
Authorization: Bearer {{instructorToken}}

###
POST {{host}}/api/bookings/00000000-0000-0000-0000-000000000000/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Calm and clear"
}

###
# Admin JWT. Development seed phone +919000000001, existing user (isNewUser false).
GET {{host}}/api/admin/providers?status=Pending
Authorization: Bearer {{adminToken}}

###
POST {{host}}/api/admin/providers/00000000-0000-0000-0000-000000000000/verify
Authorization: Bearer {{adminToken}}

###
POST {{host}}/api/admin/providers/00000000-0000-0000-0000-000000000000/reject
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Incomplete profile"
}

###
GET {{host}}/api/admin/users?q=Ananya&role=Provider
Authorization: Bearer {{adminToken}}

###
GET {{host}}/api/admin/bookings?status=PendingAccept&from=2026-09-23&to=2026-09-30
Authorization: Bearer {{adminToken}}

###
GET {{host}}/api/admin/payments?status=Paid
Authorization: Bearer {{adminToken}}

###
GET {{host}}/api/admin/payouts
Authorization: Bearer {{adminToken}}

###
GET {{host}}/api/admin/reports/summary
Authorization: Bearer {{adminToken}}

###
PATCH {{host}}/api/admin/policy
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "platformFeePercent": 15,
  "cancelFreeWindowHours": 12
}

###
POST {{host}}/api/webhooks/razorpay
Content-Type: application/json
X-Razorpay-Signature: hex hmac sha256 of the raw body using Razorpay:WebhookSecret

{
  "event": "payment.captured",
  "payload": {
    "payment": {
      "entity": {
        "id": "pay_example",
        "order_id": "order_fake_example",
        "status": "captured",
        "amount": 89900,
        "currency": "INR"
      }
    }
  }
}
