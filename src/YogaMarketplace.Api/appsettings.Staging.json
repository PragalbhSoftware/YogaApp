{
  "Otp": {
    "ExposeCode": false,
    "UseFixedCode": false
  },
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "DemoData": false
  },
  "Razorpay": {
    "UseFakeGateway": false
  },
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  }
}
