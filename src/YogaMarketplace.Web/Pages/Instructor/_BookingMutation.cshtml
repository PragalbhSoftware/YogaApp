@model YogaMarketplace.Web.Pages.Instructor.BookingMutationBody
<div data-mutation data-ok="@(Model.Ok ? "true" : "false")" data-stays="@(Model.Stays ? "true" : "false")">
    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="notice notice-ok" role="status" data-notice>
            <p>@Model.Notice</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="notice notice-alert" role="alert" data-notice>
            <p>@Model.Error</p>
        </div>
    }
    @if (Model.Card is not null)
    {
        <partial name="_InstructorBookingCard" model="Model.Card" />
    }
</div>
