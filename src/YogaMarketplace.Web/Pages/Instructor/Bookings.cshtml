@page "/instructor/bookings"
@model YogaMarketplace.Web.Pages.Instructor.BookingsModel
@{
    ViewData["Title"] = UiCopy.InstructorInboxTitle;
}

<div class="flow">
    <header class="flow-intro">
        <p class="kicker">@UiCopy.InstructorInboxNav</p>
        <h1>@UiCopy.InstructorInboxTitle</h1>
        <p class="lead">@UiCopy.InstructorInboxLead</p>
        <p class="section-link"><a asp-page="/Instructor/Availability">@UiCopy.InstructorAvailabilityNav</a></p>
    </header>

    <nav aria-label="@UiCopy.StatusFilter">
        <ul class="pills">
            <li>
                <a class="pill @(Model.Status is null ? "active" : null)"
                   aria-current="@(Model.Status is null ? "page" : null)"
                   asp-page="/Instructor/Bookings">@UiCopy.FilterAll</a>
            </li>
            @foreach (var status in BookingStatuses.All)
            {
                var active = Model.Status == status;
                <li>
                    <a class="pill @(active ? "active" : null)"
                       aria-current="@(active ? "page" : null)"
                       asp-page="/Instructor/Bookings"
                       asp-route-status="@status">@BookingStatusText.FilterLabel(status)</a>
                </li>
            }
        </ul>
    </nav>

    <div data-notice-host aria-live="polite">
        @if (!string.IsNullOrEmpty(Model.Notice))
        {
            <div class="notice notice-ok" role="status" data-notice>
                <p>@Model.Notice</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="notice notice-alert" role="alert" data-notice>
                <p>@Model.Error</p>
            </div>
        }
    </div>
    <p class="visually-hidden" data-action-status aria-live="polite"></p>

    @if (string.IsNullOrEmpty(Model.Error) && Model.Bookings.Count == 0)
    {
        <div class="notice" data-empty role="status">
            <p class="notice-title">@UiCopy.NoInstructorBookings</p>
            <p>@UiCopy.NoInstructorBookingsHint</p>
        </div>
    }
    else if (Model.Bookings.Count > 0)
    {
        <div class="booking-list inbox-list" data-booking-list>
            @foreach (var card in Model.Cards)
            {
                <partial name="_InstructorBookingCard" model="card" />
            }
        </div>
        <template id="inbox-empty">
            <div class="notice" data-empty role="status">
                <p class="notice-title">@UiCopy.NoInstructorBookings</p>
                <p>@UiCopy.NoInstructorBookingsHint</p>
            </div>
        </template>
    }
</div>
<script src="~/js/instructor.js" asp-append-version="true"></script>
