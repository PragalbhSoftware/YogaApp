@page "/instructor/bookings"
@model YogaMarketplace.Web.Pages.Instructor.BookingsModel
@{
    ViewData["Title"] = UiCopy.InstructorInboxTitle;
}

<h1>@UiCopy.InstructorInboxTitle</h1>
<p class="lead">@UiCopy.InstructorInboxLead</p>

<nav aria-label="@UiCopy.StatusFilter">
    <ul class="pills">
        <li>
            <a class="pill @(Model.Status is null ? "active" : null)" asp-page="/Instructor/Bookings">@UiCopy.FilterAll</a>
        </li>
        @foreach (var status in BookingStatuses.All)
        {
            <li>
                <a class="pill @(Model.Status == status ? "active" : null)" asp-page="/Instructor/Bookings" asp-route-status="@status">@BookingStatusText.FilterLabel(status)</a>
            </li>
        }
    </ul>
</nav>

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <p class="hint" role="status">@Model.Notice</p>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="alert" role="alert">@Model.Error</p>
}

@if (string.IsNullOrEmpty(Model.Error) && Model.Bookings.Count == 0)
{
    <p role="status">@UiCopy.NoInstructorBookings</p>
}
else if (Model.Bookings.Count > 0)
{
    @foreach (var booking in Model.Bookings)
    {
        <article class="card" data-booking-id="@booking.Id" data-slot-id="@booking.SlotId" data-status="@booking.Status">
            <h2>@booking.ServiceTitle</h2>
            <partial name="_SessionFacts" model="booking" />
            @if (InstructorBookingCommands.CanAccept(booking.Status))
            {
                <form method="post" data-action="accept" asp-page-handler="Accept" asp-route-id="@booking.Id" asp-route-status="@Model.Status">
                    <button type="submit">@UiCopy.AcceptBooking</button>
                </form>
            }
            @if (InstructorBookingCommands.CanDecline(booking.Status))
            {
                <form method="post" data-action="decline" asp-page-handler="Decline" asp-route-id="@booking.Id" asp-route-status="@Model.Status">
                    <button type="submit" class="secondary">@UiCopy.DeclineBooking</button>
                </form>
            }
            @if (InstructorBookingCommands.CanComplete(booking.Status))
            {
                <form method="post" data-action="complete" asp-page-handler="Complete" asp-route-id="@booking.Id" asp-route-status="@Model.Status">
                    <button type="submit">@UiCopy.CompleteBooking</button>
                </form>
            }
        </article>
    }
}
