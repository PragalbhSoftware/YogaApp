@page "/bookings/pay"
@model YogaMarketplace.Web.Pages.Bookings.PayModel
@{
    ViewData["Title"] = UiCopy.PayTitle;
}

<div class="flow">
    @if (Model.Draft is { } back)
    {
        <p class="back-link"><a asp-page="/Instructors/Profile" asp-route-id="@back.ProviderId" asp-route-mode="@back.Mode">@UiCopy.BackToInstructor</a></p>
    }
    else
    {
        <p class="back-link"><a asp-page="/Instructors/Index">@UiCopy.BackToList</a></p>
    }

    <header class="flow-intro">
        <p class="kicker">@UiCopy.PayKicker</p>
        <h1>@UiCopy.PayTitle</h1>
        @if (Model.Draft is not null)
        {
            <p class="lead">@(Model.UseFakeCheckout ? UiCopy.PayLead : UiCopy.PayLiveLead)</p>
        }
    </header>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="notice notice-alert" role="alert">
            <p>@Model.Error</p>
        </div>
    }

    @if (Model.Draft is { } draft && Model.Summary is { } summary)
    {
        <article class="book-card checkout-card">
            <div class="summary-who">
                <span class="avatar" aria-hidden="true">@PersonMark.Initials(summary.ProviderName)</span>
                <div class="person-copy">
                    <div class="name-row">
                        <p class="checkout-name">@summary.ProviderName</p>
                        <p class="trust">@UiCopy.TrustVerified</p>
                    </div>
                </div>
            </div>
            <partial name="_CheckoutSummary" model="summary" />
            <p class="muted pay-note" data-order-id="@draft.OrderId">@string.Format(UiCopy.OrderId, draft.OrderId)</p>

            @if (Model.UseFakeCheckout)
            {
                <div class="pay-actions">
                    <form method="post" data-once data-busy="@UiCopy.PayingNow" asp-page-handler="Pay">
                        <button type="submit">@UiCopy.PayNow</button>
                        <p class="visually-hidden" data-form-status aria-live="polite"></p>
                    </form>
                    <div class="secondary-row">
                        <form method="post" data-once asp-page-handler="Fail">
                            <button type="submit" class="secondary">@UiCopy.PaymentFailedButton</button>
                        </form>
                        <form method="post" data-once asp-page-handler="Abandon">
                            <button type="submit" class="secondary">@UiCopy.AbandonPayment</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <form id="confirm-form" method="post" asp-page-handler="Confirm">
                    <input type="hidden" asp-for="OrderId" id="orderId" />
                    <input type="hidden" asp-for="PaymentId" id="paymentId" />
                    <input type="hidden" asp-for="Signature" id="signature" />
                </form>
                <form id="fail-form" method="post" asp-page-handler="Fail"></form>
                <form id="abandon-form" method="post" asp-page-handler="Abandon"></form>
                <button type="button" id="razorpay-open">@UiCopy.PayWithRazorpay</button>
                <div id="rzp-order"
                     hidden
                     data-key="@draft.KeyId"
                     data-amount="@draft.AmountPaise"
                     data-currency="@draft.Currency"
                     data-order="@draft.OrderId"
                     data-name="@UiCopy.AppName"
                     data-description="@draft.ProviderName"></div>
                <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
                <script src="~/js/checkout.js" asp-append-version="true"></script>
            }
        </article>
    }
    else
    {
        <a class="button" asp-page="/Instructors/Index">@UiCopy.BackToList</a>
    }
</div>
<script src="~/js/booking.js" asp-append-version="true"></script>
