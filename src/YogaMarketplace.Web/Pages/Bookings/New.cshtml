@page "/bookings/new"
@model YogaMarketplace.Web.Pages.Bookings.NewModel
@{
    ViewData["Title"] = UiCopy.BookTitle;
}

<div class="flow">
    @if (Model.ProviderId != Guid.Empty)
    {
        <p class="back-link"><a asp-page="/Instructors/Profile" asp-route-id="@Model.ProviderId" asp-route-mode="@Model.Mode">@UiCopy.BackToInstructor</a></p>
    }
    else
    {
        <p class="back-link"><a asp-page="/Instructors/Index">@UiCopy.BackToList</a></p>
    }

    <header class="flow-intro">
        <p class="kicker">@UiCopy.BookCta</p>
        <h1>@UiCopy.BookTitle</h1>
        <p class="lead">@UiCopy.BookLead</p>
    </header>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="notice notice-alert" role="alert">
            <p>@Model.Error</p>
        </div>
    }

    @if (Model.Summary is { } summary)
    {
        <article class="book-card checkout-card">
            <div class="summary-who">
                <span class="avatar" aria-hidden="true">@PersonMark.Initials(summary.ProviderName)</span>
                <div class="person-copy">
                    <div class="name-row">
                        <p class="checkout-name">@summary.ProviderName</p>
                        <p class="trust">@UiCopy.TrustVerified</p>
                    </div>
                </div>
            </div>
            <partial name="_CheckoutSummary" model="summary" />
            <form method="post" data-once data-busy="@UiCopy.ContinuingToPayment" asp-route-providerId="@Model.ProviderId" asp-route-slotId="@Model.SlotId" asp-route-mode="@Model.Mode">
                <input type="hidden" asp-for="ProviderId" />
                <input type="hidden" asp-for="SlotId" />
                <input type="hidden" asp-for="Mode" />
                @if (Model.NeedsHomeAddress)
                {
                    <div class="home-fields">
                        <p class="lead">@UiCopy.HomeAddressLead</p>
                        <div class="field">
                            <label asp-for="HomeAddress">@UiCopy.HomeAddress</label>
                            <input asp-for="HomeAddress" autocomplete="street-address" maxlength="@HomeVisitLimits.AddressMaxLength" />
                        </div>
                        <div class="field">
                            <label asp-for="Landmark">@UiCopy.Landmark</label>
                            <input asp-for="Landmark" maxlength="@HomeVisitLimits.LandmarkMaxLength" />
                        </div>
                    </div>
                }
                <button type="submit">@UiCopy.ContinueToPayment</button>
                <p class="visually-hidden" data-form-status aria-live="polite"></p>
            </form>
        </article>
    }
</div>
<script src="~/js/booking.js" asp-append-version="true"></script>
