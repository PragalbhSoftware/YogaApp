@page "/instructors/{id:guid}"
@model YogaMarketplace.Web.Pages.Instructors.ProfileModel
@{
    ViewData["Title"] = Model.DocumentTitle;
    ViewData["Description"] = Model.MetaDescription;
    ViewData["Shell"] = "shell-wide";
}

<div class="catalog">
    <p class="back-link"><a asp-page="/Instructors/Index">@UiCopy.BackToList</a></p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <h1>@UiCopy.ProfileTitle</h1>
        <div class="notice notice-alert" role="alert">
            <p>@Model.Error</p>
        </div>
    }
    else if (Model.Instructor is { } instructor)
    {
        <div class="profile-split">
        <header class="identity">
            <span class="avatar avatar-lg" aria-hidden="true">@PersonMark.Initials(instructor.DisplayName)</span>
            <div class="person-copy">
                <p class="kicker">@UiCopy.CategoryName · @instructor.Area, @instructor.City</p>
                <div class="name-row">
                    <h1>@instructor.DisplayName</h1>
                    @if (string.Equals(instructor.Status, ProviderStatuses.Verified, StringComparison.OrdinalIgnoreCase))
                    {
                        <p class="trust">@UiCopy.TrustVerified</p>
                    }
                </div>
                @if (instructor.Age is int age)
                {
                    <p class="muted">@string.Format(UiCopy.AgeLabel, age)</p>
                }
                @if (instructor.ReviewCount > 0 && instructor.RatingAverage is decimal rating)
                {
                    <p class="rating">@string.Format(UiCopy.RatingLine, rating.ToString("0.0"), instructor.ReviewCount)</p>
                }
                <p class="review-note">@UiCopy.ReviewsFromCompleted</p>
                @if (instructor.Modes.Count > 0)
                {
                    <ul class="mode-pills">
                        @foreach (var mode in instructor.Modes)
                        {
                            <li>@mode.Mode</li>
                        }
                    </ul>
                }
            </div>
        </header>

        <aside class="book-card">
            <h2 id="rates-heading">@UiCopy.SessionType</h2>
            @if (instructor.Modes.Count == 0)
            {
                <div class="notice">
                    <p class="notice-title">@UiCopy.NoModes</p>
                </div>
            }
            else
            {
                <ul class="mode-list">
                    @foreach (var mode in instructor.Modes)
                    {
                        var selected = Model.IsSelected(mode.Mode);
                        <li>
                            <a asp-page="/Instructors/Profile"
                               asp-route-id="@instructor.Id"
                               asp-route-mode="@mode.Mode"
                               aria-current="@(selected ? "page" : null)">
                                <span class="mode-choice-copy">
                                    <span class="mode-choice-name">@mode.Mode</span>
                                    <span class="mode-choice-hint">@Model.ModeHint(mode.Mode)</span>
                                </span>
                                <span class="mode-meta">
                                    <span class="rate-amount">@Money.Inr(mode.Rate)</span>
                                    @if (selected)
                                    {
                                        <span class="mode-state">@UiCopy.Selected</span>
                                    }
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
            @if (Model.SelectedRate is { } rate)
            {
                <div class="price-callout">
                    <p class="price-figure">@Money.Inr(rate.Rate)</p>
                    <p>@string.Format(UiCopy.ShowingMode, rate.Mode, Money.Inr(rate.Rate))</p>
                </div>
            }
            <a class="button" href="#open-slots">@UiCopy.BookCta</a>
        </aside>

        <div class="profile-story">
        @if (!string.IsNullOrWhiteSpace(instructor.Bio))
        {
            <p class="prose-card">@instructor.Bio</p>
        }
        @if (!string.IsNullOrWhiteSpace(instructor.StudioAddress))
        {
            <p class="place-line"><strong>@UiCopy.StudioAddress.</strong> @instructor.StudioAddress</p>
        }

        <section class="profile-section" id="open-slots" aria-labelledby="slots-heading">
            <h2 id="slots-heading">@UiCopy.SlotsTitle</h2>
            <p class="muted">@UiCopy.SlotsLead</p>
            @if (Model.From is DateOnly from && Model.To is DateOnly to)
            {
                <p class="muted">@string.Format(UiCopy.SlotRange, from.ToString("d MMM"), to.ToString("d MMM"))</p>
            }
            @if (!string.IsNullOrEmpty(Model.SlotsError))
            {
                <div class="notice notice-alert" role="alert">
                    <p>@Model.SlotsError</p>
                </div>
            }
            else if (Model.Slots.Count == 0)
            {
                <div class="notice">
                    <p class="notice-title">@UiCopy.NoSlots</p>
                </div>
            }
            else
            {
                @foreach (var day in Model.Slots.GroupBy(slot => slot.Date))
                {
                    <h3 class="day-label">@day.Key.ToString("dddd d MMM")</h3>
                    <ul class="slot-list">
                        @foreach (var slot in day)
                        {
                            <li>
                                @if (Model.CanBook(slot))
                                {
                                    <a class="slot-book" asp-page="/Bookings/New" asp-route-providerId="@instructor.Id" asp-route-slotId="@slot.Id" asp-route-mode="@Model.Mode" aria-label="@string.Format(UiCopy.BookSlot, slot.Start, slot.End)">
                                        <span>@slot.Start–@slot.End</span>
                                        <span class="slot-go">@UiCopy.BookCta</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="slot-ended">@slot.Start–@slot.End · @UiCopy.SlotEnded</span>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </section>
        </div>
        </div>
    }
</div>
